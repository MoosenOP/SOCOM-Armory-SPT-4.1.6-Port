<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SOCOM</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.0.3</Version>
    <PathMap>$(MSBuildProjectDirectory)=SOCOM</PathMap>
    <!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)-$(Version)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>SOCOM</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Resources\db\CustomQuestZones\**" />
    <Content Remove="Resources\db\CustomQuestZones\**" />
    <EmbeddedResource Remove="Resources\db\CustomQuestZones\**" />
    <None Remove="Resources\db\CustomQuestZones\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Common"><HintPath>../references/SPTarkov.Common.dll</HintPath></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>../references/SPTarkov.DI.dll</HintPath></Reference>
    <Reference Include="SPTarkov.Server.Core"><HintPath>../references/SPTarkov.Server.Core.dll</HintPath></Reference>
    <Reference Include="SemanticVersioning"><HintPath>../references/SemanticVersioning.dll</HintPath></Reference>
    <Reference Include="SPTarkov.Reflection"><HintPath>../references/SPTarkov.Reflection.dll</HintPath></Reference>
    <Reference Include="WTT-ServerCommonLib"><HintPath>../references/WTT-ServerCommonLib.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Include EVERYTHING under Resources -->
    <Content Include="Resources\**\*">
      <!-- This makes the copied path omit the 'Resources\' prefix -->
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <!-- Turn off the SDK's default Content items -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

</Project>
